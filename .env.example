# Tripwire CCTV Intrusion System Configuration
APP_NAME="Tripwire CCTV Zone Intrusion"
DEBUG=false

# Computer Vision & Tracking Settings
MODEL_NAME=yolov8n.pt
CONFIDENCE_THRESHOLD=0.40
IOU_THRESHOLD=0.45
IMGSZ=640
FRAME_SKIP=0
TARGET_FPS=25

# Intrusion Event Parameters
DEBOUNCE_FRAMES=2
COOLDOWN_SECONDS=8.0
LOITERING_SECONDS=6.0

# Ring Buffer Video Clip Settings (Seconds)
PRE_BUFFER_SECONDS=3.0
POST_BUFFER_SECONDS=3.0

# Telegram Bot Alert Channel (Optional)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Generic Webhook Channel (Optional)
WEBHOOK_URL=""

# SMTP Email Alert Channel (Optional)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
ALERT_EMAIL_TO=""
ALERT_EMAIL_FROM=""

# UI Audio Alert (Web Audio Synthesizer)
ENABLE_AUDIO_ALERT=true
