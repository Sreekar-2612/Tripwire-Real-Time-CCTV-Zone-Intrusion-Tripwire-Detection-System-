# Tripwire Configuration Example
# Copy this file to .env and update with your values

# Application Settings
APP_NAME=Tripwire CCTV Zone Intrusion
DEBUG=False

# Database
DATABASE_URL=sqlite:///./data/tripwire.db

# Computer Vision Settings
MODEL_NAME=yolov8n.pt
CONFIDENCE_THRESHOLD=0.40
IOU_THRESHOLD=0.45
IMGSZ=640
FRAME_SKIP=0
TARGET_FPS=25

# Detection & Event Logic
DEBOUNCE_FRAMES=2
COOLDOWN_SECONDS=8.0
LOITERING_SECONDS=6.0

# Recording Buffer
PRE_BUFFER_SECONDS=3.0
POST_BUFFER_SECONDS=3.0

# Alert Channels - Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Alert Channels - Webhook
WEBHOOK_URL=

# Alert Channels - Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=

# Audio Alerts
ENABLE_AUDIO_ALERT=True
